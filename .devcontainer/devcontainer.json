{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "PROJECT_NAME": "${localWorkspaceFolderBasename}"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:1": {}
  },
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.codespaces",
        "ms-vscode-remote.remote-containers",
        "github.remotehub",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "anthropic.claude-code",
        "google.geminicodeassist",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers"
      ]
    }
  },
  "runArgs": ["--name", "${localWorkspaceFolderBasename}"],
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code @google/gemini-cli opencode-ai && (gh extension install github/gh-copilot || true)",
  "remoteUser": "vscode"
}
